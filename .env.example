# Literal assignments only; no shell commands or variable interpolation.
# Optional in demo mode. Do not commit actual credentials.
NEBIUS_API_KEY=
# The supplied private local Mneme service runs on 8010, not the scaffold's 8000.
MNEME_MCP_URL=http://127.0.0.1:8010/mcp/
# The Resident's OWN agent key (namespace agent-resident). Create or rotate it from the Mneme repo:
#   .\.venv-local\Scripts\python.exe scripts\agent_key.py create resident --env-file ..\autonomous-digital-resident\.env
# Do not put the personal key here, and do not set MNEME_LOCAL_CONFIG (it would load the personal key).
MNEME_API_KEY=
# Optional immutable local Docker image ID, obtained after pulling a trusted Python image:
# RESIDENT_EXECUTION_IMAGE=sha256:...
# Optional web search providers (used in this order). Without either, web_search uses DuckDuckGo HTML.
# TAVILY_API_KEY=
# BRAVE_API_KEY=
