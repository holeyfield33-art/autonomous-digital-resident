# Nebius Token Factory
NEBIUS_API_KEY=your_nebius_token_factory_api_key_here
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Preferred NVIDIA model(s) — at least one must be used meaningfully
# Examples (check current catalog):
# nvidia/Nemotron-3_5-Lightning
# nvidia/nemotron-3-super-120b-a12b
# nvidia/Nemotron-3-Ultra-550b-a55b
# nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
PRIMARY_MODEL=nvidia/Nemotron-3_5-Lightning
FALLBACK_MODEL=nvidia/nemotron-3-super-120b-a12b

# Aletheia Mneme (https://github.com/holeyfield33-art/Mneme-)
# MCP endpoint of your running instance (local Docker, uvicorn, or Render)
MNEME_MCP_URL=http://localhost:8000/mcp
MNEME_API_KEY=mneme_p_your_personal_or_created_key_here

# Runtime
RESIDENT_WORKSPACE=./workspace
LOG_LEVEL=INFO
CYCLE_INTERVAL_SECONDS=300
MAX_CYCLES=0
